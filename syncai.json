{
  "config": {
    "interval": 5,
    "workdir": ""
  },
  "agents": [
    {
      "name": "cursor",
      "rules": {
        "pattern": ".cursor/rules/*.mdc"
      },
      "context": {
        "path": ".cursorrules"
      },
      "ignore": {
        "path": ".cursorignore"
      },
      "skills": {
        "pattern": ".cursor/skills/*"
      }
    },
    {
      "name": "copilot",
      "rules": {
        "pattern": ".github/instructions/*.instruction.md"
      },
      "context": {
        "path": ".github/copilot-instructions.md"
      },
      "skills": {
        "pattern": ".github/skills/*"
      }
    },
    {
      "name": "claude",
      "context": {
        "path": "CLAUDE.md"
      },
      "skills": {
        "pattern": ".claude/skills/*"
      }
    },
    {
      "name": "codex",
      "context": {
        "path": "AGENTS.md"
      },
      "skills": {
        "pattern": ".codex/skills/*"
      }
    },
    {
      "name": "opencode",
      "context": {
        "path": "AGENTS.md"
      },
      "skills": {
        "pattern": ".opencode/command/*"
      }
    }
  ]
}
